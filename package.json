{
  "name": "capped-discount-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run prisma:generate && npm run prisma:push && remix vite:build",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:push": "node scripts/run-prisma.mjs db push",
    "db:check": "node scripts/test-db-connection.js",
    "db:migrate": "node scripts/run-prisma.mjs migrate deploy",
    "dev": "npx @shopify/cli app dev",
    "deploy": "npx @shopify/cli app deploy",
    "start": "remix-serve ./build/server/index.js",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.2",
    "@shopify/shopify-api": "^13.1.0",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^5.2.2",
    "@shopify/ui-extensions": "2026.10.0",
    "isbot": "^5.1.17",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@shopify/cli": "latest",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "prisma": "^6.19.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.1"
  }
}
