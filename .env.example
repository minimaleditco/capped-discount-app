# ============================================================================
# Shopify App Credentials
# ============================================================================
# Client ID (SHOPIFY_API_KEY)
SHOPIFY_API_KEY=your_client_id_here

# Client Secret (SHOPIFY_API_SECRET)
SHOPIFY_API_SECRET=your_client_secret_here

# App Access Scopes
SCOPES=write_discounts,read_discounts,write_orders,read_orders,write_draft_orders,read_draft_orders

# App Public URL (e.g. Render Web Service URL or Cloudflare Tunnel)
SHOPIFY_APP_URL=https://capped-discount-app.onrender.com
PORT=3000

# ============================================================================
# Database Configuration
# ============================================================================
# Leave this as the local SQLite file for development and tests:
#   DATABASE_URL="file:./dev.db"
#
# In production set it to the Neon Postgres connection string (direct, not
# pooled). The build then generates the Postgres client and creates the tables:
#   DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="file:./dev.db"

# Connection pool overrides (optional)
# connection_limit: Maximum concurrent connections in the Prisma pool (default: 5)
# pool_timeout: Maximum seconds to wait before query pool timeout (default: 10)
DB_POOL_LIMIT=5
DB_POOL_TIMEOUT=10
