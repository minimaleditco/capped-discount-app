# ============================================================================
# Shopify App Credentials
# ============================================================================
# Client ID (SHOPIFY_API_KEY)
SHOPIFY_API_KEY=your_client_id_here

# Client Secret (SHOPIFY_API_SECRET)
SHOPIFY_API_SECRET=your_client_secret_here

# App Access Scopes
SCOPES=write_discounts,read_discounts,write_orders,read_orders,write_draft_orders,read_draft_orders

# App Public URL (e.g. Render Web Service URL or Cloudflare Tunnel)
SHOPIFY_APP_URL=https://capped-discount-app.onrender.com
PORT=3000

# ============================================================================
# Database Configuration (Managed PostgreSQL on Render)
# ============================================================================
# Render Managed PostgreSQL Connection URL.
# If hosting on Render in the same region, use the Internal Database URL:
#   DATABASE_URL=postgresql://user:password@dpg-xxxx-a:5432/dbname
# If connecting externally, use the External Database URL with SSL:
#   DATABASE_URL=postgresql://user:password@dpg-xxxx-a.singapore-postgres.render.com/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capped_discount_app?sslmode=prefer

# High-Velocity Connection Pooling (Optional Overrides)
# connection_limit: Maximum concurrent connections in the Prisma pool (default: 25)
# pool_timeout: Maximum seconds to wait before query pool timeout (default: 10)
DB_POOL_LIMIT=25
DB_POOL_TIMEOUT=10
